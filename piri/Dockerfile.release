# Runtime image for goreleaser release builds (see .goreleaser.yaml `dockers`).
#
# Unlike the main Dockerfile, this does NOT compile: goreleaser cross-compiles
# the per-arch `piri` binary and drops it into the build context, so this just
# packages it. That keeps the release build context to a single binary, which
# matters in the monorepo — the compiling Dockerfile needs the repo root as its
# context, this one does not.
#
# Mirrors the main Dockerfile's `prod` target: alpine (for the wget-based
# healthchecks smelt points at piri) running as nobody, with a bare ENTRYPOINT
# so the compose `command:` supplies the subcommand.
FROM alpine:latest

USER nobody

COPY piri /usr/bin/piri

ENTRYPOINT ["/usr/bin/piri"]
